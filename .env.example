# Redis password. The compose entrypoint starts redis with
# --requirepass "$REDIS_PASSWORD" (wrapped in a shell because the redis
# image does not expand env vars itself).
REDIS_PASSWORD="password"
# REDIS_URL must carry the same credentials. Redis 6+ ACL syntax: username
# "default", then the password. Keep the password in sync with REDIS_PASSWORD
# above (nested $VAR expansion in .env is not reliable across compose
# versions, so the value is written out explicitly).
REDIS_URL="redis://default:password@redis:6379"

# ---------------------------------------------------------------------------
# HTTPS (optional). Leave everything unset to serve plain HTTP on PORT (8080),
# e.g. behind a reverse proxy / CDN that terminates TLS for you.
#
# Option A — automatic Let's Encrypt certificate (ACME). Needs the host to be
# reachable from the internet on ports 80 and 443 with DNS pointing at it.
# The certificate is cached in TLS_CACHE_DIR (a docker volume in compose) and
# renewed automatically.
#TLS_DOMAINS="poker.example.com"
#TLS_EMAIL="you@example.com"
#TLS_CACHE_DIR="/app/certs"
#
# Option B — your own certificate (bought, certbot, or self-signed for a LAN).
# Mount the files into the container and point at them.
#TLS_CERT_FILE="/app/certs/fullchain.pem"
#TLS_KEY_FILE="/app/certs/privkey.pem"
#
# Port the HTTPS listener binds inside the container (compose maps it to
# HTTPS_PORT on the host as well). With TLS on, the plain PORT (8080, mapped
# to HTTP_PORT on the host) only serves ACME challenges and redirects to https.
#HTTPS_PORT=443
#HTTP_PORT=80

# ---------------------------------------------------------------------------
# Abuse protection (all optional; the defaults shown are applied when unset).
# Kernel-level SYN-flood protection is configured on the host, not here: see
# deploy/HARDENING.md.
#
# Take the client IP from X-Forwarded-For / X-Real-IP. ONLY enable behind a
# reverse proxy you control, otherwise clients can spoof their IP and dodge
# the per-IP limits.
#TRUST_PROXY=false
# HTTP requests per second per IP (burst = 2x). 429 when exceeded.
#RATE_HTTP_RPS=30
# WebSocket messages per second per connection (burst = 2x). The socket is
# closed when exceeded.
#RATE_WS_MSGS=20
# Login / register attempts per minute per IP (brute-force protection).
#RATE_AUTH_PER_MIN=10
# Concurrent WebSocket connections per IP and in total. Extra handshakes get
# a 429 before any upgrade work is done.
#MAX_CONNS_PER_IP=10
#MAX_CONNS=2000
# Maximum number of live rooms (a room is recycled 2 min after it empties).
#MAX_TABLES=200
# Comma-separated WebSocket Origin allow-list. Empty = accept any origin
# (needed for `make hot`, where the page is on :8080 and the socket on :3000).
# Set it in production to your site origin(s).
#ALLOWED_ORIGINS="https://poker.example.com"
